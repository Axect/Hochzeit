---
import journey from '@data/journey.json';
import { t, tField, formatDate, fmt, withBase, type Locale } from '@lib/i18n';
import JourneyMap from '@components/JourneyMap.tsx';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t('journey.title', locale);
const intro = t('journey.intro', locale);
const previewHint = t('journey.previewHint', locale);
const openButton = t('journey.openButton', locale);
const closeButton = t('journey.closeButton', locale);
const momentCount = fmt(t('journey.momentCount', locale), { count: journey.events.length });

interface RawPhoto {
  src: string;
  width: number;
  height: number;
  alt?: string;
}

interface RawEvent {
  photos?: RawPhoto[];
  from?: { lat: number; lon: number };
}

const events = journey.events.map((ev) => {
  const raw = ev as unknown as RawEvent;
  return {
    id: ev.id,
    kind: ev.kind as 'letter' | 'visit' | 'trip' | 'wedding',
    date: ev.date,
    lat: ev.lat,
    lon: ev.lon,
    from: raw.from,
    title: tField(ev.title, locale) ?? '',
    body: tField(ev.body, locale) ?? '',
    dateFormatted: formatDate(ev.date, locale, { year: 'numeric', month: 'short', day: 'numeric' }),
    photos: raw.photos ?? [],
  };
});

const labels = {
  prev: t('journey.prev', locale),
  next: t('journey.next', locale),
  reducedMotionNote: t('journey.reducedMotionNote', locale),
  open: openButton,
  close: closeButton,
  hint: previewHint,
  momentCount,
  viewPhoto: t('journey.viewPhoto', locale),
  additionalPhotos: t('journey.additionalPhotos', locale),
  kindLabel: {
    letter: t('journey.kindLabel.letter', locale),
    visit: t('journey.kindLabel.visit', locale),
    trip: t('journey.kindLabel.trip', locale),
    wedding: t('journey.kindLabel.wedding', locale),
  },
};
const backgroundImage = withBase('/journey/first-letter-bg.png');
---

<section
  id="journey"
  aria-label={title}
  class="relative flex min-h-[100svh] w-full flex-col overflow-hidden bg-[oklch(0.30_0.06_150)] text-white"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -inset-10 bg-cover bg-center bg-no-repeat opacity-90 blur-xl saturate-110"
    style={`background-image: url('${backgroundImage}');`}
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-contain bg-center bg-no-repeat opacity-90 md:bg-cover md:opacity-100"
    style={`background-image: url('${backgroundImage}');`}
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[oklch(0.12_0.04_150)]/58 backdrop-blur-[1px]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[oklch(0.12_0.04_150)]/50 via-transparent to-[oklch(0.29_0.055_150)]/95"
  >
  </div>
  <div class="relative z-10">
    <JourneyMap client:load events={events} labels={labels} title={title} intro={intro} />
  </div>
</section>
