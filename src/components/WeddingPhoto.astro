---
import gallery from '@data/gallery.json';
import GalleryLightbox from '@components/GalleryLightbox.tsx';
import { t, tField, type Locale } from '@lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const title = t('weddingPhoto.title', locale);
const subtitle = t('weddingPhoto.subtitle', locale);
const items = gallery.items.map((item) => ({ ...item, alt: tField(item.alt, locale) ?? '' }));
const labels = { open: t('gallery.openLightbox', locale), close: t('gallery.closeLightbox', locale), prev: t('gallery.previousImage', locale), next: t('gallery.nextImage', locale) };
---

<section id="wedding-photo" class="relative w-full overflow-hidden bg-[linear-gradient(180deg,oklch(0.97_0.014_92),oklch(0.94_0.025_85)_100%)] px-5 py-20 sm:px-6" aria-labelledby="wedding-photo-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_8%,rgba(255,255,255,0.92),transparent_28%),radial-gradient(circle_at_88%_72%,rgba(183,132,83,0.13),transparent_38%)]"></div>
  <div class="relative z-10 mx-auto w-full max-w-3xl">
    <header class="mb-10 text-center">
      <p class="text-[10px] font-medium uppercase tracking-[0.3em] text-[var(--color-accent)]">{subtitle}</p>
      <h2 id="wedding-photo-title" class="mt-3 font-serif text-3xl text-[var(--color-fg)] sm:text-4xl">{title}</h2>
      <span aria-hidden="true" class="mx-auto mt-5 block h-px w-12 bg-[var(--color-gold)]"></span>
    </header>
    <GalleryLightbox client:visible items={items} labels={labels} />
  </div>
</section>
