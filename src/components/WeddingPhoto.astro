---
import { t, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t('weddingPhoto.title', locale);
const comingSoon = t('weddingPhoto.comingSoon', locale);
---

<section
  id="wedding-photo"
  class="relative w-full overflow-hidden bg-[linear-gradient(180deg,oklch(0.88_0.03_145)_0%,oklch(0.94_0.025_85)_35%,oklch(0.96_0.018_85)_100%)] px-6 py-20"
  aria-labelledby="wedding-photo-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_18%,rgba(255,255,255,0.8),transparent_34%),radial-gradient(circle_at_50%_78%,rgba(214,188,124,0.16),transparent_42%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-36 bg-gradient-to-b from-transparent to-[var(--color-bg)]"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-md">
    <header class="mb-10 text-center">
      <h2 id="wedding-photo-title" class="font-serif text-2xl text-[var(--color-fg)] sm:text-3xl">
        {title}
      </h2>
      <span aria-hidden="true" class="mx-auto mt-4 block h-px w-12 bg-[var(--color-accent)]" />
    </header>

    <figure class="mx-auto w-full max-w-sm border border-[oklch(0.69_0.075_95)] bg-[oklch(0.985_0.008_85)] p-2 shadow-[0_22px_48px_rgba(38,58,39,0.12)]">
      <div class="relative flex aspect-[4/5] flex-col items-center justify-center overflow-hidden border border-[oklch(0.79_0.055_95)] bg-[linear-gradient(145deg,rgba(255,255,255,0.95),rgba(236,241,231,0.72))] p-7 text-center">
        <span aria-hidden="true" class="absolute inset-3 border border-[oklch(0.84_0.035_95)]"></span>
        <div class="relative flex items-baseline font-serif text-[clamp(3.5rem,15vw,5.75rem)] leading-none text-[var(--color-fg)]">
          <span>T</span>
          <span class="mx-3 text-[0.42em] text-[var(--color-accent)]">&amp;</span>
          <span>A</span>
        </div>
        <span aria-hidden="true" class="relative mt-6 block h-px w-16 bg-[var(--color-accent)]/70"></span>
        <span class="relative mt-4 text-[10px] uppercase tracking-[0.28em] text-[var(--color-muted)]">{comingSoon}</span>
      </div>
    </figure>
  </div>
</section>
