---
import { t, tField, withBase, type Locale } from '@lib/i18n';
import venue from '@config/venue.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groomName = t('cover.groomName', locale);
const brideName = t('cover.brideName', locale);
const coverGroomName = locale === 'ko' ? groomName : groomName.split(' ')[0];
const coverBrideName = locale === 'ko' ? brideName : brideName.split(' ')[0];
const coverGroomNameParts = coverGroomName.split(/\s+/).filter(Boolean);
const coverBrideNameParts = coverBrideName.split(/\s+/).filter(Boolean);
const dateLine = t('cover.dateLine', locale);
const timeLine = t('cover.timeLine', locale);
const venueLine = `${tField(venue.name, locale)} - ${tField(venue.hall, locale)}`;
const scrollHint = t('cover.scrollHint', locale);
const eyebrow =
  locale === 'ko' ? 'Getting married' : locale === 'en' ? 'Getting married' : 'Wir heiraten';
const coverImage = withBase('/main/cover-poster.jpg');
---

<section
  class="relative isolate min-h-[100svh] overflow-hidden bg-[oklch(0.30_0.06_150)] text-white"
  aria-label={`${groomName} and ${brideName}`}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_18%,oklch(0.35_0.055_150)_0%,transparent_44%),linear-gradient(180deg,transparent_0%,oklch(0.24_0.045_150)_100%)]"
  >
  </div>

  <div class="relative mx-auto flex min-h-[100svh] w-full max-w-[42rem] flex-col px-6 pb-8 pt-10 sm:px-9 sm:pt-12">
    <div class="flex h-28 items-start gap-5 text-[oklch(0.78_0.13_80)]">
      <span class="h-full w-px bg-current/80"></span>
      <p class="[writing-mode:vertical-rl] font-serif text-xs uppercase tracking-[0.38em]">
        T &amp; A &middot; 2026
      </p>
    </div>

    <div
      aria-hidden="true"
      class="mt-5 aspect-square w-full flex-none rounded-[2rem] border border-[oklch(0.78_0.13_80)]/35 bg-cover bg-center shadow-2xl shadow-black/25 sm:mt-6"
      style={`background-image: url('${coverImage}');`}
    >
    </div>

    <header class="relative z-10 mt-6">
      <div
        class="mx-auto flex w-full flex-col items-center rounded-[1.75rem] border border-[oklch(0.78_0.13_80)]/55 bg-[oklch(0.30_0.06_150)]/92 px-5 py-6 text-center shadow-2xl shadow-black/30 backdrop-blur-md sm:px-10 sm:py-8"
      >
        <p class="text-[0.7rem] uppercase tracking-[0.34em] text-[oklch(0.82_0.10_80)] sm:text-xs">
          &middot; {eyebrow} &middot;
        </p>
        <h1
          class="mt-6 flex flex-wrap items-baseline justify-center gap-x-3 gap-y-2 break-keep font-serif uppercase leading-none text-white text-[clamp(2rem,8vw,3.35rem)] sm:mt-7"
        >
          <span class="inline-flex flex-wrap justify-center gap-x-2">
            {coverGroomNameParts.map((part) => <span class="whitespace-nowrap">{part}</span>)}
          </span>
          <span class="mx-3 text-[oklch(0.82_0.10_80)]" aria-hidden="true">&amp;</span>
          <span class="inline-flex flex-wrap justify-center gap-x-2">
            {coverBrideNameParts.map((part) => <span class="whitespace-nowrap">{part}</span>)}
          </span>
        </h1>
        <div class="mt-6 flex items-center gap-5 text-[oklch(0.82_0.10_80)] sm:mt-8">
          <span class="h-px w-12 bg-current/70"></span>
          <span class="text-lg leading-none" aria-hidden="true">&diams;</span>
          <span class="h-px w-12 bg-current/70"></span>
        </div>
        <div class="mt-6 space-y-2 text-white/90 sm:mt-8">
          <p class="text-[clamp(1rem,4vw,1.35rem)] uppercase tracking-[0.18em]">{dateLine}</p>
          <p class="text-sm font-semibold text-white/70 sm:text-base">{venueLine} - {timeLine}</p>
        </div>
      </div>
    </header>

    <footer class="relative z-10 flex justify-center pb-2 pt-5 text-center">
      <a
        href="#greeting"
        class="group flex flex-col items-center gap-2 text-[0.65rem] uppercase tracking-[0.3em] text-white/60 sm:text-xs"
      >
        {scrollHint}
        <span
          aria-hidden="true"
          class="h-8 w-px bg-gradient-to-b from-[oklch(0.82_0.10_80)]/80 to-transparent transition-transform group-hover:translate-y-1"
        >
        </span>
      </a>
    </footer>
  </div>
</section>
